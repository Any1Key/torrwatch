# Bootstrap/system configuration only. Do not place tracker or client credentials here.
TORRWATCH_DATA_DIR=/data
TORRWATCH_LOG_LEVEL=INFO
TORRWATCH_BIND=0.0.0.0
TORRWATCH_PORT=8080
TORRWATCH_MASTER_KEY_FILE=/data/master.key
# Persistent job ownership: renewal must remain shorter than the lease.
TORRWATCH_WORKER_JOB_LEASE_SECONDS=180
TORRWATCH_WORKER_LEASE_RENEWAL_SECONDS=60

# Shared tracker transport; TLS verification is always enabled.
TORRWATCH_HTTP_CONNECT_TIMEOUT_SECONDS=10
TORRWATCH_HTTP_READ_TIMEOUT_SECONDS=30
TORRWATCH_HTTP_WRITE_TIMEOUT_SECONDS=30
TORRWATCH_HTTP_POOL_TIMEOUT_SECONDS=10
TORRWATCH_HTTP_MAX_ATTEMPTS=3
TORRWATCH_HTTP_USER_AGENT=TorrWatch/0.1

# Set these before the first startup. The password is used once to create the
# administrator and is never stored in plaintext.
TORRWATCH_ADMIN_USERNAME=admin
TORRWATCH_ADMIN_PASSWORD=change-this-before-first-start

# Set true when TorrWatch is served through HTTPS by a reverse proxy.
TORRWATCH_SESSION_HTTPS_ONLY=false
